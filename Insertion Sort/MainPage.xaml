<Page
    x:Class="Insertion_Sort.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Insertion_Sort"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    controls:BackdropMaterial.ApplyToRootOrPageBackground="True">
    <Grid x:Name="BackgroundGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>
        <controls:InfoBar Title="Пропущенные значения:"
                          x:Name="infoBar"
                          Severity="Warning"/>
        <Button x:Name="сlearButton"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Content="Очистить"
                Click="сlearButton_Click"
                IsEnabledChanged="сlearButton_IsEnabledChanged"
                FontSize="12"
                ToolTipService.ToolTip="Очистить список"
                Width="100"
                Height="30"
                Margin="5"
                CornerRadius="14"
                Opacity="0"
                IsEnabled="False">
            <Button.Shadow>
                <ThemeShadow/>
            </Button.Shadow>
            <Button.TranslationTransition>
                <Vector3Transition/>
            </Button.TranslationTransition>
            <Button.OpacityTransition>
                <ScalarTransition/>
            </Button.OpacityTransition>
        </Button>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    x:Name="startText"
                    Grid.Row="1">
            <Border CornerRadius="100"
                    Width="160"
                    Height="160"
                    BorderThickness="1">
                <Border.Background>
                    <ImageBrush ImageSource="Assets\StartScreen.jpg"
                                Stretch="UniformToFill"/>
                </Border.Background>
            </Border>
            <StackPanel Orientation="Vertical"
                        VerticalAlignment="Center"
                        Margin="10 0 0 0">
                <TextBlock Text="Начало работы"
                           FontSize="28"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Left"/>
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="12"
                           Margin="0 5"
                           Width="228"
                           TextAlignment="Left"
                           TextWrapping="Wrap">
Нажмите &quot;<Run Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">+</Run>&quot;, чтобы добавить число, или введите в поле несколько чисел через пробел.
                </TextBlock>
            </StackPanel>
        </StackPanel>
        <Viewbox StretchDirection="DownOnly"
                 Grid.Row="1"
                 Margin="15">
            <ItemsControl ItemsSource="{x:Bind values}">
                <ItemsControl.ItemContainerTransitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition/>
                    </TransitionCollection>
                </ItemsControl.ItemContainerTransitions>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="125"
                                Margin="10"
                                Height="125"
                                CornerRadius="8"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                                Tag="{Binding}"
                                x:Name="data"
                                Loaded="data_Loaded">
                            <ContentPresenter Content="{Binding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              FontSize="28"
                                              Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                            </ContentPresenter>
                            <Border.Shadow>
                                <ThemeShadow/>
                            </Border.Shadow>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Viewbox>
        <Border BorderThickness="1"
                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                Background ="{ThemeResource ControlFillColorDefaultBrush}"
                Width="175"
                CornerRadius="8"
                Margin="10"
                x:Name="debugMode"
                Grid.Row="1"
                Grid.Column="1"
                Visibility="Collapsed">
            <Border.OpacityTransition>
                <ScalarTransition/>
            </Border.OpacityTransition>
            <Border.TranslationTransition>
                <Vector3Transition/>
            </Border.TranslationTransition>
            <Border.Shadow>
                <ThemeShadow/>
            </Border.Shadow>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="48"/>
                </Grid.RowDefinitions>
                <Button x:Name="closeDebug"
                        Click="closeDebug_Click"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Width="28"
                        Height="28"
                        Grid.Row="0"
                        Margin="5"
                        Padding="0"
                        HorizontalAlignment="Right"
                        ToolTipService.ToolTip="Закрыть окно отладки">
                    <FontIcon Glyph="&#xE8BB;"
                              FontSize="12"/>
                </Button>
                <ListView Background="Transparent"
                          Grid.Row="1"
                          x:Name="steps"
                          BorderBrush="Transparent"
                          HorizontalAlignment="Center"
                          FontSize="12"/>
                <Button x:Name="nextStep"
                        Click="nextStep_Click"
                        Grid.Row="2"
                        Width="100"
                        Height="28"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="Далее"
                        FontSize="12"
                        HorizontalAlignment="Center"
                        ToolTipService.ToolTip="Следующий шаг">
                </Button>
            </Grid>
        </Border>
        <Border Grid.Row="2"
                VerticalAlignment="Bottom"
                x:Name="instrumental"
                CornerRadius="8"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderThickness="1"
                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                Width="325"
                Height="46"
                Margin="0 0 0 10">
            <Border.Shadow>
                <ThemeShadow/>
            </Border.Shadow>
            <Border.TranslationTransition>
                <Vector3Transition/>
            </Border.TranslationTransition>
            <Border.OpacityTransition>
                <ScalarTransition/>
            </Border.OpacityTransition>
            <Border.Resources>
                <Storyboard x:Key="progressOpen">
                    <DoubleAnimation EnableDependentAnimation="True" Storyboard.TargetName="instrumental" Storyboard.TargetProperty="Width" From="325" To="46" Duration="0:0:0.167"/>
                    <DoubleAnimation Storyboard.TargetName="test" Storyboard.TargetProperty="Opacity" From="1.0" To="0.0" Duration="0:0:0.167"/>
                    <DoubleAnimation Storyboard.TargetName="progressRing" Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.167"/>
                </Storyboard>
                <Storyboard x:Key="progressClose">
                    <DoubleAnimation EnableDependentAnimation="True" Storyboard.TargetName="instrumental" Storyboard.TargetProperty="Width" From="46" To="325" Duration="0:0:0.167"/>
                    <DoubleAnimation Storyboard.TargetName="test" Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.167"/>
                    <DoubleAnimation Storyboard.TargetName="progressRing" Storyboard.TargetProperty="Opacity" From="1.0" To="0.0" Duration="0:0:0.167"/>
                </Storyboard>
            </Border.Resources>
            <Grid>
                <controls:ProgressRing x:Name="progressRing"
                                       Opacity="0"/>
                <StackPanel Orientation="Horizontal"
                            x:Name="test">
                    <Button Margin="5"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            ToolTipService.ToolTip="Выбор режима сортировки">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Полная сортировка"
                                                x:Name="insertionSort"
                                                IsEnabled="False"
                                                Click="insertionSort_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE71C;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Режим отладки"
                                                x:Name="debugSort"
                                                IsEnabled="False"
                                                Click="debugSort_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE71A;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <FontIcon Glyph="&#xE8CB;"
                                  FontSize="14"/>
                    </Button>
                    <AppBarSeparator/>
                    <Button x:Name="addItem"
                            Click="addItem_Click"
                            Margin="5"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            ToolTipService.ToolTip="Добавить число">
                        <FontIcon Glyph="&#xE710;"
                                  FontSize="14"/>
                    </Button>
                    <TextBox Width="180"
                             x:Name="textBox"
                             Margin="5"
                             Height="32"
                             PlaceholderText="Поле для ввода"
                             TextAlignment="Center"
                             ToolTipService.ToolTip="Введите одно число или несколько (через пробел)"/>
                    <Button x:Name="deleteItem"
                            Click="deleteItem_Click"
                            Margin="5"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            ToolTipService.ToolTip="Удалить последнее число">
                        <FontIcon Glyph="&#xE74D;"
                                  FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>

