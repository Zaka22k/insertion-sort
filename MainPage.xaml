<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="InsertionSort.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:InsertionSort.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Padding="0,28" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Main visualisation workspace  -->
        <Border
            Grid.Row="0"
            Margin="28,0"
            Padding="22"
            Background="{ThemeResource ControlFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlElevationBorderBrush}"
            BorderThickness="1"
            CornerRadius="16">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>



                    <Border
                        Grid.Column="1"
                        Padding="12,7"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="9">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="{Binding CurrentStepNumberText}" />
                    </Border>
                </Grid>

                <!--  Current operation and key  -->
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <TextBlock
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="{Binding CurrentStepDescription}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding SortedCountText}" />
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Padding="12,8"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                        CornerRadius="10"
                        Visibility="{Binding HasCurrentKey, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="KEY" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="{Binding CurrentKeyText}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!--  Sequence  -->
                <Grid Grid.Row="2">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="34"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE9D2;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="Пока нет чисел" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Введите значения ниже или создайте случайный массив."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <GridView
                        Padding="8"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        IsItemClickEnabled="False"
                        IsTabStop="False"
                        ItemsSource="{Binding Cells}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollMode="Enabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        SelectionMode="None"
                        Visibility="{Binding HasValues, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <GridView.ItemContainerTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition />
                                <ContentThemeTransition />
                                <ReorderThemeTransition />
                                <EntranceThemeTransition />
                            </TransitionCollection>
                        </GridView.ItemContainerTransitions>
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>

                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Width="104"
                                    Height="112"
                                    Margin="7">
                                    <Border
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12" />

                                    <Border
                                        Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                        CornerRadius="12"
                                        Visibility="{Binding IsSorted, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <Border
                                        Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                        CornerRadius="12"
                                        Visibility="{Binding IsGap, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <Border
                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                        CornerRadius="12"
                                        Visibility="{Binding IsCompared, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <Border
                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                        CornerRadius="12"
                                        Visibility="{Binding IsShifted, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <Border
                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                        CornerRadius="12"
                                        Visibility="{Binding IsInserted, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="5">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="27"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            Text="{Binding DisplayText}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="ПУСТО"
                                            Visibility="{Binding IsGap, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="10"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Position}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>

                <!--  Visual legend  -->
                <StackPanel
                    Grid.Row="3"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="18">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border
                            Width="12"
                            Height="12"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="3" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Позиция ключа" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border
                            Width="12"
                            Height="12"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            CornerRadius="3" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Сравнение" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border
                            Width="12"
                            Height="12"
                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                            CornerRadius="3" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Перемещение / вставка" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Input and playback controls  -->
        <StackPanel
            Grid.Row="1"
            Margin="28,0"
            Spacing="10">
            <InfoBar
                Title="Проверьте ввод"
                IsClosable="False"
                IsOpen="{Binding HasInputError}"
                Message="{Binding InputError}"
                Severity="Warning" />

            <Border
                Padding="14"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Data input  -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBox
                            Width="260"
                            MinWidth="200"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding CanEditValues}"
                            PlaceholderText="Например: 8 3 5 1.5"
                            Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ToolTipService.ToolTip="Введите числа через пробел или точку с запятой" />

                        <Button
                            VerticalAlignment="Center"
                            Command="{Binding AddInputCommand}"
                            Content="Добавить" />

                        <Button
                            VerticalAlignment="Center"
                            Command="{Binding AddRandomValuesCommand}"
                            Content="Случайный массив" />

                        <Button
                            VerticalAlignment="Center"
                            Command="{Binding RemoveLastValueCommand}"
                            Content="Удалить" />

                        <Button
                            VerticalAlignment="Center"
                            Command="{Binding ClearValuesCommand}"
                            Content="Очистить" />
                    </StackPanel>

                    <!--  Playback actions  -->
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Command="{Binding SortCommand}"
                            Content="Начать"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Visibility="{Binding CanStartSorting, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Button
                            Command="{Binding PauseCommand}"
                            Content="Пауза"
                            Visibility="{Binding CanPauseSorting, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Button
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Command="{Binding ResumeCommand}"
                            Content="Продолжить"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Visibility="{Binding CanResumeSorting, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Button
                            Command="{Binding CancelSortCommand}"
                            Content="Отменить"
                            Visibility="{Binding CanCancelSorting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <!--  Speed control  -->
                    <Grid
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Скорость" />

                        <Slider
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Maximum="2000"
                            Minimum="100"
                            StepFrequency="100"
                            ToolTipService.ToolTip="Интервал между шагами сортировки"
                            Value="{Binding StepDelayMilliseconds, Mode=TwoWay}" />

                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding StepDelayDescription}" />
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
