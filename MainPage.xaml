<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="InsertionSort.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:converters="using:InsertionSort.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="28" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="5" VerticalAlignment="Center">
                <TextBlock
                    Text="Сортировка вставками"
                    FontSize="30"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock
                    Text="Наблюдайте, как алгоритм последовательно вставляет элементы в отсортированную часть массива."
                    FontSize="14"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border
                Grid.Column="1"
                Padding="16,10"
                CornerRadius="12"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                BorderThickness="1"
                VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        Text="{Binding ValueCount}"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="чисел"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main visualisation workspace -->
        <Border
            Grid.Row="1"
            Padding="22"
            CornerRadius="16"
            Background="{ThemeResource ControlFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlElevationBorderBrush}"
            BorderThickness="1">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="3">
                        <TextBlock
                            Text="Визуализация алгоритма"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock
                            Text="{Binding StatusMessage}"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Padding="12,7"
                        CornerRadius="9"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding CurrentStepNumberText}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Border>
                </Grid>

                <!-- Current operation and key -->
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding CurrentStepDescription}"
                            FontSize="14"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock
                            Text="{Binding SortedCountText}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Padding="12,8"
                        CornerRadius="10"
                        Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                        Visibility="{Binding HasCurrentKey, Converter={StaticResource BooleanToVisibilityConverter}}"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                Text="KEY"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="{Binding CurrentKeyText}"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Sequence -->
                <Grid Grid.Row="2">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <FontIcon
                            Glyph="&#xE9D2;"
                            FontSize="34"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="Пока нет чисел"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="Введите значения ниже или создайте случайный массив."
                            FontSize="13"
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center" />
                    </StackPanel>

                    <GridView
                        ItemsSource="{Binding Cells}"
                        SelectionMode="None"
                        IsItemClickEnabled="False"
                        IsTabStop="False"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Padding="8"
                        Visibility="{Binding HasValues, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid
                                    Orientation="Horizontal"
                                    MaximumRowsOrColumns="3" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>

                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="104" Height="112" Margin="7">
                                    <Border
                                        CornerRadius="12"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                                        BorderThickness="1" />

                                    <Border
                                        CornerRadius="12"
                                        Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                        Visibility="{Binding IsSorted, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <Border
                                        CornerRadius="12"
                                        Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                        Visibility="{Binding IsGap, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <Border
                                        CornerRadius="12"
                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                        Visibility="{Binding IsCompared, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <Border
                                        CornerRadius="12"
                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                        Visibility="{Binding IsShifted, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <Border
                                        CornerRadius="12"
                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                        Visibility="{Binding IsInserted, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <StackPanel
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Spacing="5">
                                        <TextBlock
                                            Text="{Binding DisplayText}"
                                            FontSize="27"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            HorizontalAlignment="Center"
                                            />
                                        <TextBlock
                                            Text="ПУСТО"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            HorizontalAlignment="Center"
                                            Visibility="{Binding IsGap, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock
                                            Text="{Binding Position}"
                                            FontSize="10"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>

                <!-- Visual legend -->
                <StackPanel
                    Grid.Row="3"
                    Orientation="Horizontal"
                    Spacing="18"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border
                            Width="12"
                            Height="12"
                            CornerRadius="3"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" />
                        <TextBlock
                            Text="Позиция ключа"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border
                            Width="12"
                            Height="12"
                            CornerRadius="3"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
                        <TextBlock
                            Text="Сравнение"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border
                            Width="12"
                            Height="12"
                            CornerRadius="3"
                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
                        <TextBlock
                            Text="Перемещение / вставка"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Input and playback controls -->
        <StackPanel Grid.Row="2" Spacing="10">
            <InfoBar
                Title="Проверьте ввод"
                Message="{Binding InputError}"
                IsOpen="{Binding HasInputError}"
                IsClosable="False"
                Severity="Warning" />

            <Border
                Padding="14"
                CornerRadius="14"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                BorderThickness="1">
                <Grid RowSpacing="12" ColumnSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Data input -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <TextBox
                            Width="260"
                            MinWidth="200"
                            PlaceholderText="Например: 8 3 5 1.5"
                            ToolTipService.ToolTip="Введите числа через пробел или точку с запятой"
                            Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding CanEditValues}"
                            VerticalAlignment="Center" />

                        <Button
                            Content="Добавить"
                            Command="{Binding AddInputCommand}"
                            VerticalAlignment="Center" />

                        <Button
                            Content="Случайный массив"
                            Command="{Binding AddRandomValuesCommand}"
                            VerticalAlignment="Center" />

                        <Button
                            Content="Удалить"
                            Command="{Binding RemoveLastValueCommand}"
                            VerticalAlignment="Center" />

                        <Button
                            Content="Очистить"
                            Command="{Binding ClearValuesCommand}"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Playback actions -->
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <Button
                            Content="Начать"
                            Command="{Binding SortCommand}"
                            Visibility="{Binding CanStartSorting, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />

                        <Button
                            Content="Пауза"
                            Command="{Binding PauseCommand}"
                            Visibility="{Binding CanPauseSorting, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Button
                            Content="Продолжить"
                            Command="{Binding ResumeCommand}"
                            Visibility="{Binding CanResumeSorting, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />

                        <Button
                            Content="Отменить"
                            Command="{Binding CancelSortCommand}"
                            Visibility="{Binding CanCancelSorting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- Speed control -->
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="Скорость"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />

                        <Slider
                            Grid.Column="1"
                            Minimum="100"
                            Maximum="2000"
                            StepFrequency="100"
                            Value="{Binding StepDelayMilliseconds, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Интервал между шагами сортировки" />

                        <TextBlock
                            Grid.Column="2"
                            Text="{Binding StepDelayDescription}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Page>
